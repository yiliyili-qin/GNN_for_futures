    "interface": {
      "row_key": [
        "split",
        "cutoff_timestamp",
        "source",
        "target"
      ],
      "required_outputs": [
        "q",
        "d"
      ],
      "q": "P(follow)",
      "d": "P(same_direction_given_follow)",
      "joint_order": [
        "N",
        "O",
        "S"
      ],
      "joint_conversion": [
        "1-q",
        "q*(1-d)",
        "q*d"
      ],
      "joint_input_conversion": {
        "q": "pO+pS",
        "d": "pS/q if q>0 else 0.5"
      },
      "probability_sum_tolerance": 1e-06,
      "nonfinite_or_out_of_range": "fail_run",
      "native_q_preserved_for_AP": true,
      "common_masks_and_schedule": true,
      "model_specific_row_dropping": false,
      "architecture": "heterogeneous_allowed_same_information_set",
      "unavailable_input_policy": "shared_predeclared_mask_or_train_fitted_imputation_with_indicator_never_model_specific_drop"
    },
    "classification": {
      "primary": "macro_f1",
      "class_order": [
        "N",
        "O",
        "S"
      ],
      "follow_threshold": 0.5,
      "follow_operator": ">",
      "direction_threshold": 0.5,
      "direction_operator": ">",
      "direction_tie": "O",
      "decision": "N if q<=0.5 else S if d>0.5 else O",
      "joint_argmax": false,
      "metrics": [
        "macro_f1",
        "balanced_accuracy",
        "per_class_precision_recall_f1_support",
        "confusion_counts",
        "confusion_row_normalized",
        "follow_AP",
        "OVR_macro_AP",
        "log_loss",
        "multiclass_Brier",
        "ECE",
        "accuracy"
      ],
      "aggregation": "pooled_common_rows_no_negative_sampling",
      "zero_division_PRF1": 0,
      "macro_f1_denominator": 3,
      "balanced_accuracy": "mean_recall_over_positive_support_classes; report_supported_class_count",
      "AP_no_positive_or_no_negative": "null_with_reason",
      "OVR_macro_AP": "null_unless_all_three_AP_defined",
      "empty_evaluation": "fail_run",
      "log_loss_clip_epsilon": 1e-12,
      "log_loss_after_clip": "renormalize_each_row",
      "Brier": "mean_sum_over_three_classes_squared_error_unclipped",
      "ECE": {
        "bins": 10,
        "edges": "equal_width_0_to_1",
        "confidence": "probability_of_hierarchical_predicted_class",
        "boundary": "left_closed_right_open_last_includes_1",
        "empty_bins": "skip_zero_weight"
      }
    },
    "selection": {
      "metric": "validation_macro_f1",
      "direction": "maximize",
      "tie": "earliest_epoch_then_lexicographic_candidate_id",
