    "backtest": {
      "primary_allocator": "shifted_c0_L1_uncapped",
      "multiplier": 10.0,
      "alpha": "sum_i(source_shock_i * off_diagonal_ij * (q_ij>0.5) * q_ij*(2*d_ij-1)*source_return_i)",
      "utility": "10*alpha/sigma",
      "sigma": {
        "prior_trading_days": 10,
        "input": "signed_bar_returns",
        "ddof": 1,
        "all_nodes_finite_positive_required": true
      },
      "raw_mapping": {
