      "position_units": "fractional_continuous_price_not_futures_contracts",
      "execution": "next_complete_executable_open_same_panel_trading_date",
      "rebalance_units": "pretrade_equity*target_weight/open",
      "between_signals": "hold_units_mark_close_to_open_and_open_to_close",
      "forced_exits": [
        "trading_date_end",
        "last_complete_close_before_missing_common_quote",
        "last_complete_close_before_dominant_contract_change"
      ],
      "boundary_schedule": "retrospective_zero_cost_liquidation_not_strict_PIT",
      "reentry": "only_next_valid_scheduled_signal",
      "nonpositive_equity": "fail_no_clipping",
      "initial_equity": 1.0,
      "base_fee_bps": 0,
      "fee_stress_bps": [
        1,
        2,
        5
      ],
      "stress": {
        "mode": "fixed_zero_cost_path_not_self_financing_net_ledger",
        "cost": "bps/10000*sum(abs(trade_units)*trade_price)",
        "equity": "zero_cost_equity-cumulative_absolute_cost",
        "include": "entries_rebalances_forced_exits",
        "reinvest_or_resize": false
      },
      "margin_slippage_impact_financing": "not_modeled"
    },
    "risk": {
      "annual_days": 252,
      "risk_free": 0.0,
      "daily_calendar": "all_split_panel_trading_dates_including_cash_days",
      "daily_return": "end_equity/previous_day_end_equity-1_initial_equity_1",
      "sharpe": "sqrt(252)*mean(daily_return)/sample_std(daily_return)",
      "annual_return": "(end_equity/initial_equity)^(252/day_count)-1",
